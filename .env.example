PORT=4000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# MariaDB / MySQL connection. The database is created automatically if the user is allowed to.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ilm_hr
DB_PASSWORD=change-me
DB_NAME=ilm_hr
DB_POOL_SIZE=10

# UPLOAD_DIR=./uploads
# Comma separated list, or * for any origin
CORS_ORIGINS=*

# Push notifications (Firebase Cloud Messaging). Download the key from Firebase console →
# Project settings → Service accounts → "Generate new private key". Keep it out of git.
# FIREBASE_SERVICE_ACCOUNT=/var/www/ilm-hr-backend/secrets/firebase-service-account.json
# Optional absolute origin used in photo URLs, e.g. https://hr.example.com
# PUBLIC_URL=
